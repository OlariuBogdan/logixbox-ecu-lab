# ==========================================================================
#  Variabilele de mediu ale aplicatiei React (Vite)
# ==========================================================================
#  .env        -> valorile implicite, urcate pe GitHub (fara parole sau chei reale).
#  .env.local  -> valorile voastre personale, doar pe calculatorul vostru;
#                 este in .gitignore (regula "*.local"), deci NU ajunge pe GitHub.
#
#  Doar variabilele care incep cu VITE_ sunt disponibile in cod: import.meta.env.VITE_...

# Adresa backend-ului FastAPI, asa cum o vede browserul.
# In Docker, valoarea vine din compose.yaml (BACKEND_PORT din .env-ul principal);
# valoarea de aici se foloseste doar daca porniti frontend-ul fara Docker.
VITE_API_URL=http://localhost:8000
